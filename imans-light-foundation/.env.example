# Copy this file to .env.local and fill in real values.
# .env.local is gitignored and must never be committed.

# Neon Postgres — auto-injected into Vercel when the database is connected
# from the Vercel dashboard (Storage tab). The variable name is prefixed
# with whatever name you gave the database connection during setup (e.g.
# "Imans_Payments_") — check the actual keys in your Vercel dashboard under
# Environment Variables if these don't match. For local development, pull
# real values with: vercel env pull .env.local
Imans_Payments_DATABASE_URL=
Imans_Payments_DATABASE_URL_UNPOOLED=

# Gmail SMTP — sends the /contact form notification (and later, donation/
# ticket receipts) through imanslightfoundation@gmail.com's own App
# Password. See SETUP-TODO.md Phase 4 for how to generate one. Contact form
# submissions still save to the database even if these are unset — the
# email is a best-effort notification, not the source of truth.
GMAIL_USER=
GMAIL_APP_PASSWORD=
